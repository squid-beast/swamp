# ══════════════════════════════════════════════════════════════════════════════
# SWAMP — environment variables (the one and only template)
#
# Copy this to `.env.local` for local development:   cp .env.example .env.local
# For PRODUCTION, set these in Vercel → Settings → Environment Variables (NOT in a
# file). Each variable below says whether it's for local, production, or both.
#
# Anything marked SECRET must never be committed and never carry a NEXT_PUBLIC_
# prefix (that prefix ships the value to the browser).
# ══════════════════════════════════════════════════════════════════════════════


# ── Supabase — REQUIRED (local + production) ──────────────────────────────────
# The app refuses to start without these two. Get them from:
#   Supabase → Project Settings → API Keys
#
# LOCAL:  point at your local stack — run `supabase status` for the values.
#         (`npm run dev`, `test:e2e`, and `test:int` all create/delete rows, so
#          local must NOT point at production.)
# PROD:   point at your hosted project (https://<ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as an alias if you prefer that name.)


# ── Supabase service role — SECRET (local: tests · prod: cron jobs) ───────────
# Bypasses row-level security. Locally it's only used by the integration tests to
# create and delete throwaway users (the harness refuses to run unless the URL is
# localhost). In production it's read ONLY by the cron routes.
# Supabase → Project Settings → API Keys → the "secret" key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY


# ── Site URL — RECOMMENDED (production) ───────────────────────────────────────
# Your public origin, no trailing slash. Drives canonical URLs, the sitemap,
# robots.txt, OG images, and the links inside invite emails.
# Local: leave as-is. Prod on *.vercel.app: you can omit it (auto-detected).
# Prod on a custom domain: set it explicitly.
NEXT_PUBLIC_SITE_URL=https://swampy.app


# ── Cron secret — REQUIRED in production ──────────────────────────────────────
# Gates the background-job routes (/api/webhooks/dispatch, /api/attachments/gc,
# /api/sync). Vercel Cron sends it as a Bearer token automatically once it's set.
# Generate one:  openssl rand -hex 32
CRON_SECRET=


# ── Email (Resend) — RECOMMENDED for a real launch ────────────────────────────
# ONE Resend API key powers everything:
#   • The APP sends INVITE emails through it (Resend HTTP API).
#   • SUPABASE sends sign-up + password-reset emails through it (Resend SMTP):
#       SMTP host: smtp.resend.com · port 465 · user: resend · pass: <this key>
#     — configured in the Supabase dashboard; see docs/DEPLOY.md (P2 email).
#
# Without RESEND_API_KEY, invites still work (the inviter copies the link), and
# Supabase falls back to its built-in (rate-limited) sender. Setting it makes all
# email come from your own domain and land in inboxes.
# Get it from: resend.com → API Keys.
RESEND_API_KEY=

# The From address for app-sent emails. Must be on a domain you've verified in
# Resend. Using your real inbox (hello@) means replies reach a human instead of a
# black hole. Format: "Name <address>".
EMAIL_FROM=SWAMP <hello@swampy.app>


# ── Google — OPTIONAL (Google Sheets integration only) ────────────────────────
# Google SIGN-IN needs NOTHING here — it's configured entirely in the Supabase
# dashboard (Authentication → Providers → Google). These two are ONLY for reading
# a connected Google Sheet server-side. Leave blank if you're not using Sheets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Self-hosting only (ignored on Vercel) ──────────────────────────────────
#
# See docs/DEPLOY.md. Copy this file to .env.production ON THE SERVER — never
# commit it; .gitignore already covers .env* .

# Which deploy answered /api/health. Vercel sets VERCEL_GIT_COMMIT_SHA itself;
# self-hosted, pass this as a Docker build arg (`GIT_SHA=$(git rev-parse HEAD)`).
GIT_SHA=

# "vercel" mounts @vercel/analytics. Leave EMPTY anywhere else — off Vercel it
# posts to /_vercel/insights, which 404s on every page load and collects nothing.
NEXT_PUBLIC_ANALYTICS=

# NOTE for self-hosted Supabase: NEXT_PUBLIC_SUPABASE_URL must be the address a
# BROWSER can reach (https://api.yourdomain.com), not the internal compose
# hostname — it is inlined into the client bundle. Server-side code in the same
# compose network may use the internal name, but there is only one variable, so
# the public URL is the one that has to work.
