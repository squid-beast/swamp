# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files — never commit secrets
.env
.env*.local
.env.*

# ...but DO track the one env template. It holds only placeholders, and a repo
# without it is a repo nobody can configure from a fresh clone. The broad .env.*
# above would otherwise swallow it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor / AI tooling
# Keep Claude Code local state private, but share project rules + CLAUDE.md.
/.claude/*
!/.claude/rules/
!/.claude/rules/**
/.cursor
.idea/
.vscode/
*.swp
*~

# supabase local stack (also listed under supabase/.gitignore)
/supabase/.branches
/supabase/.temp

# vitest
.vitest/

# ── Markdown ──────────────────────────────────────────────────────────────────
# Scratch notes at the repo root are ignored; real project docs are tracked.
# Everything under docs/ and tests/ is a deliverable — do not re-ignore it.
/*.md
!/README.md
!/CLAUDE.md
!docs/**
!tests/**
